# Copy to .env and change every secret before first start.
PGUSER=mizani
PGPASSWORD=change-this-database-password
# 32+ random characters, e.g.: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
# Optional: enables /api/platform/* operator endpoints (list tenants, migrate all). Leave empty to disable.
PLATFORM_ADMIN_TOKEN=
# Set to false to close public signup once you have onboarded your clients.
ALLOW_SIGNUP=true
PORT=3000
BACKUP_KEEP_DAYS=14
